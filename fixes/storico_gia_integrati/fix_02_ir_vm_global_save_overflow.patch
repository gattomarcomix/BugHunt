+/* Bytes actually owned by a scalar global's value: copying a whole 'union AnyValue' (152 bytes)
+ * over-reads/over-writes the 72-byte allocation of a small global (ASan heap-buffer-overflow). */
+static size_t VmGlobalBytes(const struct Value *V)
+{
